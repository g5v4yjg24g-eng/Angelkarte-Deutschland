  "licences": [
    {
      "kind": "fishing_licence",
      "text": "Zusammengefasst: Die Ausübung der Fischerei bedarf der Genehmigung (Fischereischein); für Angler zur Ausübung des Fischfangs mit Angelgeräten. Voraussetzung ist die bestandene Anglerprüfung; der Fischereischein wird unbefristet erteilt und Personen unter vierzehn Jahren versagt.",
      "basisId": "BbgFischG",
      "basisRef": "§ 17 Abs. 1 und 3, § 19 Abs. 1, § 20 Abs. 1"
    },
    {
      "kind": "fishing_licence",
      "text": "Ein Fischereischein ist nicht erforderlich für Personen, die den Fischfang mit der Friedfischangel ausüben. (Friedfischhandangel: beim Fischen von Friedfischen mit tierischen oder pflanzlichen Ködern nur ein einschenkliger Haken, § 7 Abs. 1 BbgFischO.)",
      "basisId": "BbgFischG",
      "basisRef": "§ 17 Abs. 4 Nr. 3"
    },
    {
      "kind": "tourist",
      "text": "Ein Fischereischein ist nicht erforderlich für Personen, die den Fischfang mit Angelgeräten ausüben, keinen Hauptwohnsitz in Deutschland haben und sich nur für kurze Zeiträume eines Kalenderjahres in Brandenburg aufhalten.",
      "basisId": "BbgFischG",
      "basisRef": "§ 17 Abs. 4 Nr. 4"
    },
    {
      "kind": "fishing_licence",
      "text": "Gültige Fischereischeine anderer deutscher Bundesländer für Angler gelten auch in Brandenburg, es sei denn, der Inhaber hat seinen ständigen Wohnsitz in Brandenburg.",
      "basisId": "BbgFischG",
      "basisRef": "§ 17 Abs. 5"
    },
    {
      "kind": "youth",
      "text": "Zusammengefasst: Personen ab dem vollendeten 8. Lebensjahr können einen Jugendfischereischein bis zur Vollendung des 18. Lebensjahres erhalten; er berechtigt zum Gebrauch der Friedfischhandangel. Kinder unter acht Jahren dürfen nur unter ständiger und unmittelbarer Aufsicht einer volljährigen fischereiausübungsberechtigten Person mit einer Friedfischangel im Rahmen deren Angelkarte fischen und nicht keschern, abhaken, betäuben oder töten.",
      "basisId": "BbgFischG",
      "basisRef": "§ 17 Abs. 6, § 18 Abs. 1"
    },
    {
      "kind": "levy",
      "text": "Zusammengefasst: Wer die Fischerei ausüben will, hat bei der Fischereibehörde eine Fischereiabgabe zu entrichten (höchstens das Fünffache der Fischereischeingebühr). Befreit sind u. a. Personen, die die Abgabe in einem anderen Bundesland geleistet haben und ihren Hauptwohnsitz nicht in Brandenburg haben, Friedfischangler nach § 17 Abs. 4 Nr. 3 und Personen unter vierzehn Jahren.",
      "basisId": "BbgFischG",
      "basisRef": "§ 22 Abs. 2 bis 4"
    },
    {
      "kind": "permit",
      "text": "Zusammengefasst: Wer die Fischerei ausübt, muss den Fischereischein (soweit Pflicht), den Nachweis über die Fischereiabgabe (soweit keine Befreiung) und die Angelkarte oder ein Mitgliedsdokument einer auf dem Gewässer berechtigten Anglervereinigung bei sich führen und auf Verlangen vorzeigen, auch elektronisch. Angelkarten gelten höchstens ein Kalenderjahr.",
      "basisId": "BbgFischG",
      "basisRef": "§ 18 Abs. 2, § 13 Abs. 1"
    }
  ],
  "otherRules": [
    {
      "topic": "Messen",
      "text": "Als Mindestmaß gilt bei Fischen der Abstand von der Kopfspitze bis zum Ende der natürlich ausgebreiteten Schwanzflosse.",
      "basisId": "BbgFischO",
      "basisRef": "§ 2 Abs. 1 Satz 2"
    },
    {
      "topic": "Aal mit der Handangel",
      "text": "Wer Aale mit der Handangel fängt, darf nur bis zu drei Aale an einem Fangtag anlanden. Dies gilt nicht für Aale in bewirtschafteten Anlagen der Teichwirtschaft, der Fischzucht und -haltung und Gewässern ohne für den Fischwechsel geeignete Verbindung mit anderen Gewässern.",
      "basisId": "BbgFischO",
      "basisRef": "§ 2a Abs. 6"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Untermaßige Fische oder während der Schonzeit mit der Handangel gefangene Fische sind unverzüglich schonend in das Fanggewässer zurückzusetzen. Haben die Fische den Haken tief geschluckt, ist vor dem Zurücksetzen die Schnur in Höhe der Kopfspitze zu durchtrennen.",
