  "licences": [],
  "otherRules": [
    {
      "topic": "Messen",
      "text": "Als Mindestmaß gilt bei Fischen der Abstand von der Kopfspitze bis zum Ende der natürlich ausgebreiteten Schwanzflosse.",
      "basisId": "BbgFischO",
      "basisRef": "§ 2 Abs. 1 Satz 2"
    },
    {
      "topic": "Aal mit der Handangel",
      "text": "Wer Aale mit der Handangel fängt, darf nur bis zu drei Aale an einem Fangtag anlanden. Dies gilt nicht für Aale in bewirtschafteten Anlagen der Teichwirtschaft, der Fischzucht und -haltung und Gewässern ohne für den Fischwechsel geeignete Verbindung mit anderen Gewässern.",
      "basisId": "BbgFischO",
      "basisRef": "§ 2a Abs. 6"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Untermaßige Fische oder während der Schonzeit mit der Handangel gefangene Fische sind unverzüglich schonend in das Fanggewässer zurückzusetzen. Haben die Fische den Haken tief geschluckt, ist vor dem Zurücksetzen die Schnur in Höhe der Kopfspitze zu durchtrennen.",
      "basisId": "BbgFischO",
      "basisRef": "§ 3 Abs. 1"
    },
    {
      "topic": "Hecht und Zander (Erwerbsfischerei)",
      "text": "Soweit Hecht und Zander mit Fanggeräten der Erwerbsfischerei nachgestellt wird, gilt eine Schonzeit von vier aufeinanderfolgenden Wochen nach Maßgabe der zeitlichen Festlegung im Hegeplan; Mindestmaß jeweils 45 cm.",
      "basisId": "BbgFischO",
      "basisRef": "Anlage (zu § 2 Abs. 1)"
    },
    {
      "topic": "Hegepläne",
      "text": "Hegepläne enthalten u. a. eine Schonzeit für Hecht und Zander von vier aufeinanderfolgenden Wochen innerhalb ihrer Laichzeit sowie gegebenenfalls größere Mindestmaße und längere Schonzeiten als in der Anlage. Diese gewässerbezogenen Regeln stehen auf dem Erlaubnisschein und sind hier nicht erfasst.",
      "basisId": "BbgFischO",
      "basisRef": "§ 1 Abs. 2"
    }
  ]
}
