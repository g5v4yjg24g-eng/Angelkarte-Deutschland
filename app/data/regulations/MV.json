  "licences": [
    {
      "kind": "fishing_licence",
      "text": "Eine Person, die die Fischerei ausübt und das 14. Lebensjahr vollendet hat, bedarf der behördlichen Erlaubnis (Fischereischein). Der Fischereischein ist bei der Ausübung der Fischerei neben einem Personalausweis oder Identifikationsnachweis, bei Jugendlichen unter 16 Jahren neben einem amtlichen Lichtbildausweis oder Schülerausweis mitzuführen.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 7 Abs. 1"
    },
    {
      "kind": "fishing_licence",
      "text": "Der Fischereischein wird, sofern er nicht ausdrücklich zeitlich befristet ist, auf Lebenszeit erteilt. Er ist auf Antrag zu erteilen, wenn die antragstellende Person das zehnte Lebensjahr vollendet hat, eine Fischereischeinprüfung abgelegt hat oder von dieser befreit ist und keine Versagungsgründe vorliegen.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 7 Abs. 2 und 3"
    },
    {
      "kind": "fishing_licence",
      "text": "Fischereischeine, die in einem anderen Bundesland oder im Ausland von einer staatlichen Stelle erteilt oder staatlich anerkannt sind, stehen dem Fischereischein nach diesem Gesetz gleich, solange sie gültig sind und die berechtigte Person ihren Hauptwohnsitz nicht in Mecklenburg-Vorpommern hat.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 7 Abs. 8"
    },
    {
      "kind": "fishing_licence",
      "text": "Schwerbehinderte oder Menschen, die per amtsärztlichem Attest am Ablegen der Prüfung gehindert sind, sind von der Fischereischeinpflicht befreit, wenn sie unter Aufsicht einer volljährigen Person mit Fischereischein angeln; der Nachweis ist beim Angeln mitzuführen.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 7 Abs. 7"
    },
    {
      "kind": "levy",
      "text": "Wer die Fischerei ausüben will, hat eine Fischereiabgabe zu entrichten. Sie wird für das Kalenderjahr erhoben und beträgt mindestens sechs und höchstens 25 Euro. Der Nachweis über die Entrichtung muss bei der Ausübung der Fischerei mitgeführt werden.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 9 Abs. 1 und 2"
    },
    {
      "kind": "permit",
      "text": "Eine Person, die in einem Gewässer, in dem sie nicht fischereiberechtigt ist, die Fischerei ausübt, muss eine auf sie vom Fischereiberechtigten ausgestellte Fischereierlaubnis besitzen und hat diese bei der Fischereiausübung mit sich zu führen. Die Fischereierlaubnis kann auch elektronisch ausgestellt werden.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 6"
    }
  ],
  "otherRules": [
    {
      "topic": "Zurücksetzen (Binnengewässer)",
      "text": "Wer entgegen den Verboten nach den §§ 3, 4 oder 5 einen geschützten oder untermaßigen Fisch gefangen hat, hat ihn unverzüglich und mit der gebotenen Sorgfalt in das Fanggewässer zurückzusetzen.",
      "basisId": "BiFVO M-V",
      "basisRef": "§ 6 Abs. 1"
    },
    {
      "topic": "Fischwege (Binnengewässer)",
      "text": "In den Fischaufstiegs- und -abstiegshilfen (Fischwegen) und in den unmittelbar daran angrenzenden Gewässerstrecken von 100 Metern ist der Fischfang verboten.",
      "basisId": "BiFVO M-V",
      "basisRef": "§ 7"
    },
    {
      "topic": "Verbotene Fanggeräte (Binnengewässer)",
      "text": "Verboten sind reißende, klemmende oder stechende Fanggeräte sowie Haken, die reißend eingesetzt werden. Blinkern, Pilken oder Spinnen sind zulässig, sofern die Handangel nicht reißend eingesetzt wird.",
      "basisId": "BiFVO M-V",
      "basisRef": "§ 9"
    },
    {
      "topic": "EU-Recht (Küstengewässer)",
      "text": "Mindestmaße und Schonzeiten gelten, soweit nicht durch Rechtsakte der Europäischen Union strengere Vorschriften bestimmt sind. In der Freizeitfischerei gelten zusätzlich die nach europäischem Recht festgesetzten Tagesfangmengen und Bedingungen; diese sind hier nicht erfasst.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 4 Abs. 1, § 5, § 9 Abs. 4 Satz 1"
    },
    {
      "topic": "Zurücksetzen (Küstengewässer)",
      "text": "Geschützte Fische sind unverzüglich und mit der gebotenen Sorgfalt in das Fanggewässer zurückzusetzen. Haben die Fische den Haken tief geschluckt, ist vor dem Zurücksetzen die Schnur in Höhe der Kopfspitze zu durchtrennen.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 6 Abs. 1"
    },
    {
      "topic": "Handangel (Küstengewässer)",
      "text": "Die Fischerei mit Erlaubnisschein für Handangel und Köderfischsenke ist nur für den Eigenbedarf zulässig. Je Person höchstens drei Handangeln und eine Köderfischsenke, ständig beaufsichtigt; je Handangel bis zu zwei Köder mit jeweils bis zu drei Einfach-, Zwillings- oder Drillingshaken (Makrelen-/Heringspaternoster bis sechs Einfachhaken). Zu anderen Fanggeräten 100 Meter Abstand.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 9 Abs. 2, 3, 5 und 6"
    },
    {
      "topic": "Schleppangeln (Küstengewässer)",
      "text": "Zusammengefasst: In den Fischereibezirken ist das Angeln vom fahrenden Boot verboten; in einigen Seegebieten (u. a. zwischen Hiddensee und Rügen, Tromper und Prorer Wiek) vom 15. September bis 15. März mit Motor- oder Windantrieb. In Strelasund, Rassower Strom/Wieker Bodden und am Having sind Boote beim Angeln zu verankern (Driftangeln mit Treibanker ausgenommen). Genaue Abgrenzungen in § 9 Abs. 7 bis 9.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 9 Abs. 7 bis 9"
    },
    {
      "topic": "Fischschonbezirke (ganzjährig)",
      "text": "Zusammengefasst: In den Fischschonbezirken „Bock“, „Libben“, „Peenemündung“, „Usedomer Kehle“, „Nordteil Kleiner Jasmunder Bodden“ sowie an den Künstlichen Riffen „Nienhagen“ und „Rosenort“ ist die Ausübung der Fischerei verboten. Die Grenzen sind in § 11 Abs. 1 durch Koordinaten bzw. Uferlinien beschrieben.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 11 Abs. 1"
    },
    {
      "topic": "Fischschonbezirke (zeitweise)",
      "text": "Zusammengefasst: Vom 1. August bis 28. Februar (soweit nicht im Einzelfall zeitlich anders bestimmt) ist die Fischerei verboten in der „Warnowmündung“, im „Yachthafen Kühlungsborn – Bollhäger Fließ/Fulgen“ und im Gebiet bis 500 m seitlich und seewärts der Mündungen von Harkenbeck, Klützer Bach, Tarnewitzer Bach, Wallensteingraben, Abfluss des Stausees Farpen/Plastbach, Hellbach, Mühlenfließ (Schleuse Jemnitz), Recknitz, Saaler Bach, Rosengartener Beek, Barthe, Ziese, Ryck, Brebowbach, Zarow, Uecker (500-m-Kreis um die Spitze der Nordmole), Köppernitz, Blowatzer Bach, Zierower Bach, Redentiner Bach, Körkwitzer Wallbach und Neuendorfer Hechtgraben. Abweichende Zeiten: Recknitz, Saaler Bach, Rosengartener Beek, Barthe, Ziese, Ryck und Brebowbach 1. August bis 30. April; Köppernitz 1. August bis 15. März; Körkwitzer Wallbach und Neuendorfer Hechtgraben 1. Februar bis 30. April. Ausnahme: Im Fischschonbezirk „Warnowmündung“ sind die Fischerei mit der Handangel sowie mit der Langleine und Aalkörben auf Aal vom Verbot ausgenommen.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 11 Abs. 2 und 3"
    },
    {
      "topic": "Unterwarnow",
      "text": "In der Unterwarnow von der Petribrücke bis zum Unterhaupt der Schifffahrtsschleuse sowie bis zum Wehr am Mühlendamm, einschließlich des Altarmes Fischergraben, ist die Fischerei mit Stellnetzen und Aalkörben ganzjährig verboten. Bei der Fischerei mit der Handangel sind dort nur natürliche oder künstliche Köder mit einem Einfachhaken zulässig. Vom Wehr am Mühlendamm, der Schifffahrtsschleuse und vom Durchlass unter der Straße Mühlendamm zum Altarm Fischergraben ist mit jedem Fanggerät in Richtung Petribrücke ein Abstand von mindestens 100 Metern einzuhalten.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 11 Abs. 5"
    },
    {
      "topic": "Salzhaff und Halbinsel Wustrow",
      "text": "Vom 15. September bis 14. Dezember ist die Fischerei verboten im Uferbereich vom Boiensdorfer Werder bis zur Hellbachmündung (geographische Länge 11° 31,00' E bis 11° 37,00' E) bis 500 m seewärts sowie in Gebieten mit 500 m Radius um die Landdurchbrüche zwischen der Halbinsel Wustrow und dem Kieler Ort. Vom 15. September bis 30. November ist die Fischerei mit Aalkörben und Langleinen zwischen den Inseln Ummanz und Rügen im in § 11 Abs. 7 beschriebenen Gebiet nicht zulässig.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 11 Abs. 6 und 7"
    },
    {
      "topic": "Laichschonbezirke (1. April bis 31. Mai)",
      "text": "Vom 1. April bis 31. Mai ist jede Fischerei verboten in den Laichschonbezirken: Stettiner Haff (Göschenbrinksfläche, Anklamer Fähre, Borkenhaken, Usedomer See); Peenestrom (Jamitzower Hard, Balmer See, Hohendorfer See, Sauziner Bucht, Mahlzower Bucht, Rohrplan bei Zecherin, Bucht südlich Kuhler Ort (Alter Acker), Krösliner See einschließlich Alte Peene, Freester Hock, Freesendorfer See); Darßer Boddenkette (Flemendorfer Baek, Barther Strom, Fitt, Prerower Strom, Saaler Riff, Saaler Bodden, Recknitz, Küstensaum zwischen Kinnbackenhagen und Wendisch-Langendorf).",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 12 Abs. 1"
    },
    {
      "topic": "Laichschonbezirke (1. März bis 31. Mai)",
      "text": "Vom 1. März bis 31. Mai ist jede Fischerei verboten in den Laichschonbezirken: Greifswalder Bodden (Abfluss Freesendorfer See, Dänisch Wiek, Gristower Wiek, Puddeminer Wiek, Schoritzer Wiek, Wreechener See, Neuensiener See, Selliner See, Zicker See); Strelasund (Deviner See, Kemlade, Gustower Wiek, Wamper Wiek, Kubitzer Bodden); Gewässer zwischen Hiddensee und Rügen (zwischen Ummanz und Rügen, Nordteil des Wieker Boddens, Neuendorfer Wiek, Breeger Bodden nördlich der Saalsteine, Mittelsee und Spyker See, Westteil der Lietzower Bucht). Die Fischerei mit genehmigten Kumm- und Bügelreusen bleibt vom 1. bis 31. März in den Laichschonbezirken „Kubitzer Bodden“, „Gewässer zwischen Ummanz und Rügen“ und „Neuendorfer Wiek“ zulässig. Die räumliche Begrenzung ergibt sich aus Anlage 1.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 12 Abs. 2 bis 4, Anlage 1"
    }
  ]
}
