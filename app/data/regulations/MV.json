  "licences": [
    {
      "kind": "fishing_licence",
      "text": "Eine Person, die die Fischerei ausübt und das 14. Lebensjahr vollendet hat, bedarf der behördlichen Erlaubnis (Fischereischein). Der Fischereischein ist bei der Ausübung der Fischerei neben einem Personalausweis oder Identifikationsnachweis, bei Jugendlichen unter 16 Jahren neben einem amtlichen Lichtbildausweis oder Schülerausweis mitzuführen.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 7 Abs. 1"
    },
    {
      "kind": "fishing_licence",
      "text": "Der Fischereischein wird, sofern er nicht ausdrücklich zeitlich befristet ist, auf Lebenszeit erteilt. Er ist auf Antrag zu erteilen, wenn die antragstellende Person das zehnte Lebensjahr vollendet hat, eine Fischereischeinprüfung abgelegt hat oder von dieser befreit ist und keine Versagungsgründe vorliegen.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 7 Abs. 2 und 3"
    },
    {
      "kind": "fishing_licence",
      "text": "Fischereischeine, die in einem anderen Bundesland oder im Ausland von einer staatlichen Stelle erteilt oder staatlich anerkannt sind, stehen dem Fischereischein nach diesem Gesetz gleich, solange sie gültig sind und die berechtigte Person ihren Hauptwohnsitz nicht in Mecklenburg-Vorpommern hat.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 7 Abs. 8"
    },
    {
      "kind": "fishing_licence",
      "text": "Schwerbehinderte oder Menschen, die per amtsärztlichem Attest am Ablegen der Prüfung gehindert sind, sind von der Fischereischeinpflicht befreit, wenn sie unter Aufsicht einer volljährigen Person mit Fischereischein angeln; der Nachweis ist beim Angeln mitzuführen.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 7 Abs. 7"
    },
    {
      "kind": "levy",
      "text": "Wer die Fischerei ausüben will, hat eine Fischereiabgabe zu entrichten. Sie wird für das Kalenderjahr erhoben und beträgt mindestens sechs und höchstens 25 Euro. Der Nachweis über die Entrichtung muss bei der Ausübung der Fischerei mitgeführt werden.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 9 Abs. 1 und 2"
    },
    {
      "kind": "permit",
      "text": "Eine Person, die in einem Gewässer, in dem sie nicht fischereiberechtigt ist, die Fischerei ausübt, muss eine auf sie vom Fischereiberechtigten ausgestellte Fischereierlaubnis besitzen und hat diese bei der Fischereiausübung mit sich zu führen. Die Fischereierlaubnis kann auch elektronisch ausgestellt werden.",
      "basisId": "LFischG M-V",
      "basisRef": "§ 6"
    }
  ],
  "otherRules": [
    {
      "topic": "Zurücksetzen (Binnengewässer)",
      "text": "Wer entgegen den Verboten nach den §§ 3, 4 oder 5 einen geschützten oder untermaßigen Fisch gefangen hat, hat ihn unverzüglich und mit der gebotenen Sorgfalt in das Fanggewässer zurückzusetzen.",
      "basisId": "BiFVO M-V",
      "basisRef": "§ 6 Abs. 1"
    },
    {
      "topic": "Fischwege (Binnengewässer)",
      "text": "In den Fischaufstiegs- und -abstiegshilfen (Fischwegen) und in den unmittelbar daran angrenzenden Gewässerstrecken von 100 Metern ist der Fischfang verboten.",
      "basisId": "BiFVO M-V",
      "basisRef": "§ 7"
    },
    {
      "topic": "Verbotene Fanggeräte (Binnengewässer)",
      "text": "Verboten sind reißende, klemmende oder stechende Fanggeräte sowie Haken, die reißend eingesetzt werden. Blinkern, Pilken oder Spinnen sind zulässig, sofern die Handangel nicht reißend eingesetzt wird.",
      "basisId": "BiFVO M-V",
      "basisRef": "§ 9"
    },
    {
      "topic": "EU-Recht (Küstengewässer)",
      "text": "Mindestmaße und Schonzeiten gelten, soweit nicht durch Rechtsakte der Europäischen Union strengere Vorschriften bestimmt sind. In der Freizeitfischerei gelten zusätzlich die nach europäischem Recht festgesetzten Tagesfangmengen und Bedingungen; diese sind hier nicht erfasst.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 4 Abs. 1, § 5, § 9 Abs. 4 Satz 1"
    },
    {
      "topic": "Zurücksetzen (Küstengewässer)",
      "text": "Geschützte Fische sind unverzüglich und mit der gebotenen Sorgfalt in das Fanggewässer zurückzusetzen. Haben die Fische den Haken tief geschluckt, ist vor dem Zurücksetzen die Schnur in Höhe der Kopfspitze zu durchtrennen.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 6 Abs. 1"
    },
    {
      "topic": "Handangel (Küstengewässer)",
      "text": "Die Fischerei mit Erlaubnisschein für Handangel und Köderfischsenke ist nur für den Eigenbedarf zulässig. Je Person höchstens drei Handangeln und eine Köderfischsenke, ständig beaufsichtigt; je Handangel bis zu zwei Köder mit jeweils bis zu drei Einfach-, Zwillings- oder Drillingshaken (Makrelen-/Heringspaternoster bis sechs Einfachhaken). Zu anderen Fanggeräten 100 Meter Abstand.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 9 Abs. 2, 3, 5 und 6"
    },
    {
      "topic": "Schleppangeln (Küstengewässer)",
      "text": "Zusammengefasst: In den Fischereibezirken ist das Angeln vom fahrenden Boot verboten; in einigen Seegebieten (u. a. zwischen Hiddensee und Rügen, Tromper und Prorer Wiek) vom 15. September bis 15. März mit Motor- oder Windantrieb. In Strelasund, Rassower Strom/Wieker Bodden und am Having sind Boote beim Angeln zu verankern (Driftangeln mit Treibanker ausgenommen). Genaue Abgrenzungen in § 9 Abs. 7 bis 9.",
      "basisId": "KüFVO M-V",
      "basisRef": "§ 9 Abs. 7 bis 9"
    }
  ]
}
