  "licences": [
    {
      "kind": "fishing_licence",
      "text": "Wer den Fischfang ausübt, muss einen auf seinen Namen lautenden, mit Lichtbild versehenen Fischereischein bei sich führen und diesen auf Verlangen vorzeigen. Der Vierteljahresfischereischein ohne Lichtbild ist nur in Verbindung mit einem gültigen amtlichen Personaldokument gültig.",
      "basisId": "ThürFischG",
      "basisRef": "§ 26 Abs. 1 und 2"
    },
    {
      "kind": "fishing_licence",
      "text": "Zusammengefasst: Ein Fischereischein kann erstmals nach bestandener Fischerprüfung erteilt werden – als Jahres-, Fünfjahres-, Zehnjahres- oder Fischereischein auf Lebenszeit. Ohne Prüfung gibt es den Vierteljahresfischereischein (drei Monate).",
      "basisId": "ThürFischG",
      "basisRef": "§ 28, § 29 Abs. 1 und 2"
    },
    {
      "kind": "fishing_licence",
      "text": "Fischereischeine anderer Länder und anderer europäischer Staaten, sofern die Erteilung auf der Grundlage einer nachgewiesenen Qualifikation erfolgte, werden dem Thüringer Fischereischein gleichgestellt.",
      "basisId": "ThürFischG",
      "basisRef": "§ 26 Abs. 4 Satz 1"
    },
    {
      "kind": "youth",
      "text": "Personen, die das achte, aber noch nicht das vierzehnte Lebensjahr vollendet haben, darf der Fischereischein nur als Jugendfischereischein erteilt werden (ohne Fischerprüfung). Sie dürfen nur in Begleitung eines volljährigen Fischereischeininhabers (nicht Vierteljahresschein) fischen, es sei denn, sie haben die Fischerprüfung bestanden.",
      "basisId": "ThürFischG",
      "basisRef": "§ 27, § 29 Abs. 2 Nr. 2"
    },
    {
      "kind": "tourist",
      "text": "Personen ohne Wohnsitz in Deutschland oder Angehörigen des diplomatischen Corps mit ausländischem Fischereischein kann ein Fischereischein ohne Fischerprüfung erteilt werden, dann nur als Jahresfischereischein.",
      "basisId": "ThürFischG",
      "basisRef": "§ 29 Abs. 3"
    },
    {
      "kind": "levy",
      "text": "Vor Erteilung des Fischereischeins sind die Fischereischeingebühr sowie die Fischereiabgabe zu entrichten; die Höhe regelt eine Rechtsverordnung (hier nicht erfasst).",
      "basisId": "ThürFischG",
      "basisRef": "§ 33 Abs. 1"
    },
    {
      "kind": "permit",
      "text": "Ein Erlaubnisschein zum Fischfang darf nur an Personen mit gültigem Fischereischein und höchstens für ein Kalenderjahr erteilt werden. Der Inhaber hat ihn bei der Fischereiausübung mit sich zu führen und Aufsichtspersonen zur Einsichtnahme auszuhändigen.",
      "basisId": "ThürFischG",
      "basisRef": "§ 14 Abs. 1"
    }
  ],
  "otherRules": [
    {
      "topic": "Messen",
      "text": "Als Mindestmaß gilt bei Fischen der Abstand von der Kopfspitze bis zum Ende der natürlich ausgebreiteten Schwanzflosse.",
      "basisId": "ThürFischAVO",
      "basisRef": "§ 1 Abs. 2"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Untermaßige oder während der Schonzeit unbeabsichtigt gefangene Fische müssen unverzüglich schonend in das Fanggewässer zurückgesetzt werden.",
      "basisId": "ThürFischAVO",
      "basisRef": "§ 6 Abs. 1"
    },
    {
      "topic": "Anlandepflicht",
      "text": "Gefangene nicht heimische oder gebietsfremde Fische, für die keine Schonzeit oder kein Mindestmaß festgesetzt sind, müssen angelandet und dürfen nicht in das Gewässer zurückgesetzt werden.",
      "basisId": "ThürFischAVO",
      "basisRef": "§ 6 Abs. 2 Satz 1"
    },
    {
      "topic": "Köderfische",
      "text": "Fische und Teile von Fischen dürfen nur als Köder in dem Gewässer oder Gewässerabschnitt verwendet werden, aus dem sie stammen. Als Köder dürfen nur Arten eingesetzt werden, für die zum Zeitpunkt der Verwendung keine Schonzeit gilt, für die kein Mindestmaß festgelegt ist oder die das Mindestmaß erreicht haben. Köderfische dürfen nur im Rahmen der Eigenbedarfsdeckung gefangen werden; ihre Hälterung ist verboten.",
      "basisId": "ThürFischAVO",
      "basisRef": "§ 14"
    },
    {
      "topic": "Angelgeräte",
      "text": "Verboten ist das Fischen mit anderen oder mehr Angelgeräten als durch den Erlaubnisschein zum Fischfang genehmigt sind.",
      "basisId": "ThürFischAVO",
      "basisRef": "§ 16 Abs. 1 Nr. 3"
    },
    {
      "topic": "Setzkescher",
      "text": "Das Hältern von mit der Handangel gefangenen Fischen ist auf die geringstmögliche Dauer zu beschränken. Die Hälterung von Salmoniden im Setzkescher ist verboten. In Setzkeschern gehälterte Fische dürfen nicht zurückgesetzt werden.",
      "basisId": "ThürFischAVO",
      "basisRef": "§ 24 Abs. 1, 2 und 4"
    }
  ]
}
