  "licences": [],
  "otherRules": [
    {
      "topic": "Krebse und Muscheln",
      "text": "Es ist verboten, Krebsen, Muscheln und Fischnährtieren der besonders geschützten Arten (§ 7 Abs. 2 Nr. 13 des Bundesnaturschutzgesetzes) nachzustellen oder sie absichtlich zu fangen oder zu töten.",
      "basisId": "FischO LSA",
      "basisRef": "§ 2 Abs. 2 Satz 1"
    },
    {
      "topic": "Messen",
      "text": "Gemessen wird von Kopfspitze bis Schwanzspitze.",
      "basisId": "FischO LSA",
      "basisRef": "§ 4 Abs. 1"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Fische, die trotz Fangverbotes oder während der Schonzeit gefangen werden, und untermaßige Fische sind unverzüglich schonend in das Gewässer zurückzusetzen. Werden sie beim Fang nachhaltig verletzt, sind sie unverzüglich zu töten; solche Fische dürfen nicht verwertet werden, eine Aneignung ist verboten.",
      "basisId": "FischO LSA",
      "basisRef": "§ 5 Abs. 1"
    },
    {
      "topic": "Anlandepflicht",
      "text": "Gefangene Fische nicht heimischer Arten, für die weder ein Schonmaß noch eine Schonzeit festgesetzt sind, müssen angelandet und dürfen nicht in das Gewässer zurückgesetzt werden.",
      "basisId": "FischO LSA",
      "basisRef": "§ 7 Abs. 1"
    },
    {
      "topic": "Abweichungen",
      "text": "Die obere Fischereibehörde kann auf Antrag für ein bestimmtes Gewässer Abweichungen zu den Mindestmaßen zulassen; die Fischereibehörde kann den Fang bedrohter Arten verbieten und Fangmengen beschränken. Diese Abweichungen sind hier nicht erfasst.",
      "basisId": "FischO LSA",
      "basisRef": "§ 2 Abs. 4, § 3 Abs. 3, § 4 Abs. 3"
    }
  ]
}
