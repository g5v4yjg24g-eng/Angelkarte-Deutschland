  "licences": [
    {
      "kind": "fishing_licence",
      "text": "Wer den Fischfang ausübt, muss einen auf seinen Namen lautenden gültigen Fischereischein mit sich führen; ab dem vollendeten 16. Lebensjahr zusätzlich einen amtlichen Lichtbildausweis. Beides ist auf Verlangen vorzuzeigen.",
      "basisId": "LFischG SH",
      "basisRef": "§ 26 Abs. 1"
    },
    {
      "kind": "fishing_licence",
      "text": "Der Fischereischein ist auf Antrag zu erteilen, wenn die antragstellende Person das zwölfte Lebensjahr vollendet und die Fischereischeinprüfung bestanden hat; er wird auf Lebenszeit erteilt. Der Antrag kann auch online gestellt werden.",
      "basisId": "LFischG SH",
      "basisRef": "§ 26 Abs. 3"
    },
    {
      "kind": "fishing_licence",
      "text": "Fischereischeine anderer Bundesländer gelten auch in Schleswig-Holstein. Nach Umzug mit Haupt- oder alleiniger Wohnung nach Schleswig-Holstein muss der Fischereischein vergleichbare Sicherheitsmerkmale wie ein schleswig-holsteinischer aufweisen.",
      "basisId": "LFischG SH",
      "basisRef": "§ 26 Abs. 4"
    },
    {
      "kind": "youth",
      "text": "Ein Fischereischein ist nicht erforderlich für Personen, die das 14. Lebensjahr noch nicht vollendet haben und die Fischerei mit der Handangel unter Aufsicht einer volljährigen Person mit gültigem Fischereischein ausüben. Ebenfalls nicht in Teichwirtschaften und privaten Kleingewässern.",
      "basisId": "LFischG SH",
      "basisRef": "§ 26 Abs. 2 Nr. 1, 3 und 6"
    },
    {
      "kind": "tourist",
      "text": "Ausnahmen von der Fischereischeinpflicht regelt eine Verordnung; dazu zählen befristete Ausnahmegenehmigungen (Urlauberfischereischeine), deren Gültigkeit auf 28 hintereinander liegende Tage zu begrenzen ist.",
      "basisId": "LFischG SH",
      "basisRef": "§ 26 Abs. 5"
    },
    {
      "kind": "levy",
      "text": "Wer die Fischerei ausüben will und das zwölfte Lebensjahr vollendet hat, hat pro Kalenderjahr eine Fischereiabgabe zu entrichten (bis zu vier Jahre im Voraus möglich); der Nachweis ist beim Fischfang mitzuführen. Befreit ist, wer keinen Fischereischein benötigt. Die Höhe regelt eine Verordnung (hier nicht erfasst).",
      "basisId": "LFischG SH",
      "basisRef": "§ 29 Abs. 1, 2 und 6"
    },
    {
      "kind": "permit",
      "text": "Wer in einem Gewässer, ohne fischereiberechtigt oder fischereiausübungsberechtigt zu sein, den Fischfang ausübt, muß einen gültigen Fischereierlaubnisschein bei sich führen. Er darf nur an Personen mit gültigem Fischereischein oder Befreiung ausgegeben werden; nicht erforderlich in Gegenwart der ausstellungsbefugten Person und in geschlossenen Gewässern.",
      "basisId": "LFischG SH",
      "basisRef": "§ 14 Abs. 1, 2 und 4"
    }
  ],
  "otherRules": [
    {
      "topic": "Geltung",
      "text": "Die Mindestmaße und Schonzeiten der Anlage 1 gelten in offenen Binnengewässern.",
      "basisId": "BiFVO",
      "basisRef": "§ 2 Abs. 1"
    },
    {
      "topic": "Messen",
      "text": "Gemessen wird von der Kopfspitze bis zum Ende der Schwanzflosse.",
      "basisId": "BiFVO",
      "basisRef": "§ 2 Abs. 1"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Untermaßige oder in der Schonzeit gefangene Fische sind vom oder aus dem Fanggerät zu befreien und unverzüglich in das Fanggewässer zurückzusetzen, ohne Rücksicht darauf, ob sie unverletzt, verletzt oder tot sind. Offenkundig nicht überlebensfähige Fische sollen vor dem Zurücksetzen unverzüglich tierschutzgerecht betäubt und getötet werden.",
      "basisId": "BiFVO",
      "basisRef": "§ 2 Abs. 3"
    },
    {
      "topic": "Winterschonzeit",
      "text": "Zum Schutz der Winterlaicher ist der Fischfang vom 1. Oktober bis 31. Dezember in den in der Anlage 3 aufgeführten Gewässern verboten, entsprechend für deren Zuläufe mit für kieslaichende Fischarten geeigneten Substratstrukturen. Ausgenommen sind die Seen im Zuge dieser Gewässer.",
      "basisId": "BiFVO",
      "basisRef": "§ 5"
    },
    {
      "topic": "Köderfische",
      "text": "In offenen Binnengewässern dürfen nur aus dem Gewässersystem des Fanggewässers stammende oder in Aquakulturanlagen erzeugte Fische heimischer und nicht gebietsfremder Arten oder Teile von ihnen als Köder verwendet werden.",
      "basisId": "BiFVO",
      "basisRef": "§ 8"
    }
  ]
}
