  "otherRules": [
    {
      "topic": "Handangeln",
      "text": "Anglerinnen und Anglern ist es erlaubt, die Fischerei mit zwei Handangeln mit bis zu zwei Anbissstellen auszuüben.",
      "basisId": "HmbFAnGDVO",
      "basisRef": "§ 4 Abs. 1 Satz 1"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Zusammengefasst: Geschützte Arten (§ 6 Abs. 1), Fische außerhalb des Entnahmefensters und Fische in der Schonzeit sind unverzüglich mit der gebotenen Sorgfalt wieder in das Fanggewässer einzusetzen, sofern sie nicht so verletzt sind, dass ein Weiterleben voraussichtlich nur mit erheblichen Schmerzen, Leiden oder Schäden möglich ist.",
      "basisId": "HmbFAnGDVO",
      "basisRef": "§ 6 Abs. 2, § 7 Abs. 2, § 8 Abs. 1"
    },
    {
      "topic": "Köder in der Zanderschonzeit",
      "text": "Zusammengefasst: Während der Zanderschonzeit ist die Fischerei mit toten Köderfischen, Fischfetzen und Kunstködern jeglicher Art untersagt. Ausgenommen sind die Bille oberhalb des Bergedorfer Hallenbades, die Alster oberhalb der Ohlsdorfer Schleuse und der unmittelbare Strömungsbereich des Elbe-Hauptstroms; Kunstköder dürfen nur in strömenden Bereichen der Elbe verwendet werden. Das Kunstköderverbot gilt nicht für das Fliegenfischen.",
      "basisId": "HmbFAnGDVO",
      "basisRef": "§ 8 Abs. 2"
    }
  ]
}
