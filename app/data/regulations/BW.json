  "licences": [
    {
      "kind": "levy",
      "text": "Die Fischereiabgabe beträgt für jedes Kalenderjahr 12 Euro; sie kann für ein, fünf oder zehn aufeinanderfolgende Kalenderjahre gezahlt werden.",
      "basisId": "LFischVO",
      "basisRef": "§ 12 Abs. 1"
    }
  ],
  "otherRules": [
    {
      "topic": "Messen",
      "text": "Als Mindestmaß gilt der Abstand bei Fischen von der Kopfspitze bis zum Ende der natürlich ausgebreiteten Schwanzflosse, bei Krebsen von der vorderen Spitze des Kopfpanzers bis zum Ende des Schwanzes bei flach ausgelegtem Hinterleib.",
      "basisId": "LFischVO",
      "basisRef": "§ 1 Abs. 3"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Gefangene untermaßige oder der Schonzeit unterliegende Fische und Krebse müssen unverzüglich nach dem Fang sorgfältig aus den Fanggeräten gelöst und in das Gewässer zurückversetzt werden, wenn sie noch lebensfähig sind.",
      "basisId": "LFischVO",
      "basisRef": "§ 1 Abs. 4"
    },
    {
      "topic": "Anlandepflicht",
      "text": "Gefangene Fische nicht einheimischer Arten, für die weder ein Schonmaß noch eine Schonzeit festgesetzt sind, müssen angelandet und dürfen nicht in das Gewässer zurückversetzt werden.",
      "basisId": "LFischVO",
      "basisRef": "§ 2 Satz 1"
    },
    {
      "topic": "Angelgerät",
      "text": "Das Angelgerät darf höchstens drei Angelhaken haben. Jeder Fischer darf gleichzeitig höchstens mit zwei Angelgeräten fischen. Die Angelgeräte müssen ständig beaufsichtigt werden. Die Verwendung des Zockers ist verboten.",
      "basisId": "LFischVO",
      "basisRef": "§ 3 Abs. 1"
    }
  ]
}
