  "licences": [
    {
      "kind": "permit",
      "text": "Zusammengefasst: Wer in einem Gewässer, in dem er nicht Fischereiberechtigter oder Fischereipächter ist, den Fischfang ausübt, hat einen Fischereischein oder einen Personalausweis sowie eine von dem Berechtigten ausgestellte Bescheinigung über seine Befugnis bei sich zu führen (Fischereierlaubnisschein) und diese auf Verlangen vorzulegen. Nicht erforderlich bei Anwesenheit des Berechtigten oder seines Beauftragten sowie bei Fischereiwettbewerben und Prüfungen anerkannter Vereinigungen.",
      "basisId": "Nds. FischG",
      "basisRef": "§ 57"
    },
    {
      "kind": "fishing_licence",
      "text": "Personen mit Hauptwohnsitz in Niedersachsen, die das vierzehnte Lebensjahr vollendet und eine Fischerprüfung bei einem anerkannten Landesfischereiverband, die vorgeschriebene Fischerprüfung in einem anderen Bundesland oder die Prüfung als Berufsfischer abgelegt haben, stellt die Gemeinde ihres Wohnsitzes auf Antrag einen Fischereischein als Lichtbildausweis aus. Der Fischereischein gilt für unbeschränkte Zeit.",
      "basisId": "Nds. FischG",
      "basisRef": "§ 59 Abs. 1"
    }
  ],
  "otherRules": [
    {
      "topic": "Messen",
      "text": "Die Länge ist bei Fischen von der Kopfspitze bis zum äußersten Ende der Schwanzflosse, bei Krebsen von der Kopfspitze bis zum Ende des Schwanzes (Abdomen) zu messen.",
      "basisId": "BiFischO",
      "basisRef": "§ 3 Abs. 3"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Werden Fische oder Krebse, deren Fang verboten ist, lebend gefangen, so hat der Fischer sie unverzüglich wieder einzusetzen; werden sie beim Fang getötet oder sind sie nicht mehr lebensfähig, so hat er sie unverzüglich unschädlich zu beseitigen.",
      "basisId": "BiFischO",
      "basisRef": "§ 5 Abs. 1"
    },
    {
      "topic": "Köder",
      "text": "Es ist verboten, Fische oder Krebse der in § 2 Abs. 1 oder § 3 Abs. 1 aufgeführten Arten als Köder zu verwenden.",
      "basisId": "BiFischO",
      "basisRef": "§ 5 Abs. 3"
    }
  ]
}
