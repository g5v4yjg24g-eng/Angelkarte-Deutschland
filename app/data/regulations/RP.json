  "licences": [],
  "otherRules": [
    {
      "topic": "Frühjahrsschonzeit",
      "text": "Zusammengefasst: Vom 15. April bis 31. Mai gilt in den in § 18 Abs. 1 aufgezählten Gewässern eine Frühjahrsschonzeit (u. a. Rhein, Mosel außer Grenzstrecke, Lahn, Nahe, Sieg, Saar, Altrheingewässer mit offener Verbindung zum Rhein, Abschnitte weiterer Flüsse und Bäche, Mündungsbereiche der Nebengewässer bis 1 km). Angeln mit Hand- und Schleppangel bleibt erlaubt, jedoch sind Spinner, Blinker und sonstige künstliche Köder außer künstlichen Fliegen verboten. Die genaue Gewässerliste steht in § 18 Abs. 1.",
      "basisId": "LFischO RP",
      "basisRef": "§ 18"
    },
    {
      "topic": "Winterschonzeit",
      "text": "Die Winterschonzeit dauert vom 15. Oktober bis 15. März. Während dieser Zeit ist jeglicher Fischfang einschließlich der Fischerei mit der Handangel verboten. Ihr unterliegen alle offenen Gewässer, für die eine Frühjahrsschonzeit (§ 18) nicht festgesetzt ist.",
      "basisId": "LFischO RP",
      "basisRef": "§ 19"
    },
    {
      "topic": "Messen",
      "text": "Gemessen wird von der Kopfspitze bis zum Ende des längsten Teiles der Schwanzflosse, bei Krebsen bis zum Schwanzende.",
      "basisId": "LFischO RP",
      "basisRef": "§ 17"
    },
    {
      "topic": "Anlandepflicht",
      "text": "Für Fische, die nicht zu den in § 17, § 20 Abs. 2 und § 33 Abs. 1 genannten Arten zählen, besteht eine Anlandeverpflichtung.",
      "basisId": "LFischO RP",
      "basisRef": "§ 21 Satz 3"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Fische, die einem Fangverbot unterliegen, sind, wenn sie nach dem Fang noch überlebensfähig sind, unverzüglich mit der zu ihrer Erhaltung erforderlichen Vorsicht ins Gewässer zurückzusetzen.",
      "basisId": "LFischO RP",
      "basisRef": "§ 23 Abs. 1"
    },
    {
      "topic": "Lebender Köderfisch",
      "text": "Der Fischfang mit dem lebenden Köderfisch ist verboten.",
      "basisId": "LFischO RP",
      "basisRef": "§ 29"
    },
    {
      "topic": "Fischerprüfung",
      "text": "Zur Prüfung wird nicht zugelassen, wer das 13. Lebensjahr noch nicht vollendet hat; Voraussetzung ist ein Vorbereitungslehrgang von mindestens 30 Stunden, davon mindestens acht Stunden praktische Einweisung.",
      "basisId": "LFischO RP",
      "basisRef": "§ 5 Abs. 2 und 5"
    }
  ]
}
