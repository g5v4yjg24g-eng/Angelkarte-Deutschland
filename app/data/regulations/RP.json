  "licences": [
    {
      "kind": "fishing_licence",
      "text": "Zusammengefasst: Wer den Fischfang ausübt, muss einen gültigen Fischereischein und – soweit Pflicht – den Nachweis über die Fischereiabgabe besitzen, in zulässigem Format (auch digital) bei sich führen und auf Verlangen vorzeigen. Beide sind nur in Verbindung mit einem amtlichen Lichtbildausweis gültig.",
      "basisId": "LFischG RP",
      "basisRef": "§ 33 Abs. 1"
    },
    {
      "kind": "fishing_licence",
      "text": "Personen mit Hauptwohnsitz in Rheinland-Pfalz bedürfen eines Fischereischeines der zuständigen Fischereibehörde. Im Übrigen werden die in anderen Ländern ausgestellten gültigen Fischereischeine anerkannt; bei Umzug nach Rheinland-Pfalz gelten sie bis zum Ablauf ihrer Gültigkeitsdauer weiter.",
      "basisId": "LFischG RP",
      "basisRef": "§ 33 Abs. 2"
    },
    {
      "kind": "fishing_licence",
      "text": "Zusammengefasst: Der Fischereischein wird erteilt, wenn die antragstellende Person das 13. Lebensjahr vollendet hat, die Sachkunde (Fischerprüfung) besitzt und keine Versagungsgründe entgegenstehen; er wird unbefristet erteilt.",
      "basisId": "LFischG RP",
      "basisRef": "§ 34 Abs. 1 und 2, § 37 Abs. 1 Nr. 3"
    },
    {
      "kind": "youth",
      "text": "Ein Fischereischein ist nicht erforderlich für Personen, die das siebte, aber noch nicht das 18. Lebensjahr vollendet haben, soweit sie die Fischerei in Begleitung eines mindestens 18-jährigen Fischereischeininhabers ausüben, der stets unmittelbar eingreifen kann. Vor Vollendung des zehnten Lebensjahres ist das Abködern lebender Fische sowie das Betäuben und Töten von Fischen nicht erlaubt.",
      "basisId": "LFischG RP",
      "basisRef": "§ 33 Abs. 4"
    },
    {
      "kind": "tourist",
      "text": "Personen ohne Wohnsitz in Deutschland kann ein Gästeschein erteilt werden, höchstens zweimal im Kalenderjahr für jeweils bis zu 30 aufeinanderfolgende Tage; für Gästescheine wird keine Fischereiabgabe erhoben.",
      "basisId": "LFischG RP",
      "basisRef": "§ 36 Abs. 2, § 37 Abs. 1 Nr. 2, § 40 Abs. 2"
    },
    {
      "kind": "levy",
      "text": "Zusammengefasst: Von Fischereischeininhabern mit Hauptwohnsitz in Rheinland-Pfalz (auch von begleiteten Jugendlichen nach § 33 Abs. 4) wird pro Kalenderjahr eine Fischereiabgabe erhoben; Personen ohne Hauptwohnsitz in Rheinland-Pfalz zahlen nur, wenn sie keinen Nachweis über die Abgabe in einem anderen Land erbringen. Die Höhe regelt eine Rechtsverordnung (hier nicht erfasst).",
      "basisId": "LFischG RP",
      "basisRef": "§ 40 Abs. 2"
    },
    {
      "kind": "permit",
      "text": "Wer in einem Gewässer, in dem er nicht Fischereiberechtigter oder Fischereipächter ist, den Fischfang ausübt, muss unbeschadet des § 33 einen Erlaubnisschein des Fischereiberechtigten oder des Fischereipächters digital oder in Papierform bei sich führen, den Fischfang nach Maßgabe des Erlaubnisscheines ausüben und ihn auf Verlangen vorzeigen.",
      "basisId": "LFischG RP",
      "basisRef": "§ 41 Abs. 1"
    }
  ],
  "otherRules": [
    {
      "topic": "Frühjahrsschonzeit",
      "text": "Zusammengefasst: Vom 15. April bis 31. Mai gilt in den in § 18 Abs. 1 aufgezählten Gewässern eine Frühjahrsschonzeit (u. a. Rhein, Mosel außer Grenzstrecke, Lahn, Nahe, Sieg, Saar, Altrheingewässer mit offener Verbindung zum Rhein, Abschnitte weiterer Flüsse und Bäche, Mündungsbereiche der Nebengewässer bis 1 km). Angeln mit Hand- und Schleppangel bleibt erlaubt, jedoch sind Spinner, Blinker und sonstige künstliche Köder außer künstlichen Fliegen verboten. Die genaue Gewässerliste steht in § 18 Abs. 1.",
      "basisId": "LFischO RP",
      "basisRef": "§ 18"
    },
    {
      "topic": "Winterschonzeit",
      "text": "Die Winterschonzeit dauert vom 15. Oktober bis 15. März. Während dieser Zeit ist jeglicher Fischfang einschließlich der Fischerei mit der Handangel verboten. Ihr unterliegen alle offenen Gewässer, für die eine Frühjahrsschonzeit (§ 18) nicht festgesetzt ist.",
      "basisId": "LFischO RP",
      "basisRef": "§ 19"
    },
    {
      "topic": "Messen",
      "text": "Gemessen wird von der Kopfspitze bis zum Ende des längsten Teiles der Schwanzflosse, bei Krebsen bis zum Schwanzende.",
      "basisId": "LFischO RP",
      "basisRef": "§ 17"
    },
    {
      "topic": "Anlandepflicht",
      "text": "Für Fische, die nicht zu den in § 17, § 20 Abs. 2 und § 33 Abs. 1 genannten Arten zählen, besteht eine Anlandeverpflichtung.",
      "basisId": "LFischO RP",
      "basisRef": "§ 21 Satz 3"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Fische, die einem Fangverbot unterliegen, sind, wenn sie nach dem Fang noch überlebensfähig sind, unverzüglich mit der zu ihrer Erhaltung erforderlichen Vorsicht ins Gewässer zurückzusetzen.",
      "basisId": "LFischO RP",
      "basisRef": "§ 23 Abs. 1"
    },
    {
      "topic": "Lebender Köderfisch",
      "text": "Der Fischfang mit dem lebenden Köderfisch ist verboten.",
      "basisId": "LFischO RP",
      "basisRef": "§ 29"
    },
    {
      "topic": "Fischerprüfung",
      "text": "Zur Prüfung wird nicht zugelassen, wer das 13. Lebensjahr noch nicht vollendet hat; Voraussetzung ist ein Vorbereitungslehrgang von mindestens 30 Stunden, davon mindestens acht Stunden praktische Einweisung.",
      "basisId": "LFischO RP",
      "basisRef": "§ 5 Abs. 2 und 5"
    }
  ]
}
