  "licences": [
    {
      "kind": "fishing_licence",
      "text": "Zusammengefasst: Wer die Fischerei ausübt, muss Inhaberin oder Inhaber eines gültigen Fischereischeins sein und ihn auf Verlangen der Polizei, den Ordnungsbehörden oder der amtlichen Fischereiaufsicht aushändigen oder elektronisch vorzeigen; auf Verlangen ist die Identität mit einem amtlichen Lichtbildausweis nachzuweisen (bei Jugendlichen auch Schülerausweis). Der Fischereischein ist nur gültig, wenn der Nachweis über die entrichtete Fischereiabgabe erbracht ist.",
      "basisId": "LFischG",
      "basisRef": "§ 31 Abs. 1"
    },
    {
      "kind": "fishing_licence",
      "text": "Der Fischereischein wird auf Lebenszeit erteilt und nur nach erfolgreich abgelegter Fischerprüfung (Ausnahmen u. a. für ausgebildete Fischer). Gültig wird er nach Abführung der nordrhein-westfälischen Fischereiabgabe und Ausstellung des Nachweises für ein Kalenderjahr oder fünf aufeinander folgende Kalenderjahre; die Voraussetzungen müssen zum Zeitpunkt der Fischerei vorliegen.",
      "basisId": "LFischG",
      "basisRef": "§ 31 Abs. 2 und 4, § 34"
    },
    {
      "kind": "fishing_licence",
      "text": "Zusammengefasst: Ein in einem anderen Bundesland ausgestellter Fischereischein gilt in NRW, soweit der ständige Wohnsitz in diesem Land liegt; zusätzlich ist die nordrhein-westfälische Fischereiabgabe zu entrichten und der Nachweis vorzuhalten. In anderen Ländern abgelegte Fischerprüfungen werden nach § 31 Abs. 5 anerkannt.",
      "basisId": "LFischG",
      "basisRef": "§ 31 Abs. 5 und 8"
    },
    {
      "kind": "levy",
      "text": "Die Fischereiabgabe beträgt 10 Euro für ein Kalenderjahr bzw. 30 Euro für fünf Kalenderjahre und kann für bis zu fünf Jahre im Voraus entrichtet werden. Der Nachweis über die Entrichtung ist beim Fischen mitzuführen und auf Verlangen ausgedruckt oder lesbar auf einem elektronischen Gerät vorzuzeigen.",
      "basisId": "LFischVO",
      "basisRef": "§ 22a Abs. 1, § 22b"
    },
    {
      "kind": "youth",
      "text": "Kinder und Jugendliche ab dem vollendeten 10. bis vor dem vollendeten 16. Lebensjahr brauchen keinen Fischereischein, dürfen aber nur in Begleitung einer Inhaberin oder eines Inhabers eines gültigen Fischereischeins fischen; die Begleitperson weist ihr Alter auf Verlangen mit Schülerausweis oder amtlichem Lichtbildausweis nach. Einen Erlaubnisschein brauchen auch sie (§ 37 Abs. 1 Satz 2). Ein Fischereischein wird erst ab dem vollendeten 12. Lebensjahr erteilt (§ 33 Abs. 1 Nr. 1).",
      "basisId": "LFischG",
      "basisRef": "§ 31 Abs. 3 Nr. 3"
    },
    {
      "kind": "tourist",
      "text": "Personen, die nicht oder nicht länger als ein Jahr in Deutschland gemeldet sind, kann ohne Fischerprüfung ein Jahresfischereischein (Ausländerfischereischein) erteilt werden, wenn sie in anderer Weise die notwendigen Kenntnisse besitzen.",
      "basisId": "LFischG",
      "basisRef": "§ 31 Abs. 6"
    },
    {
      "kind": "permit",
      "text": "Wer in einem Gewässer fischt, in dem er nicht Fischereiberechtigter oder Fischereipächter ist, muss unabhängig vom Fischereischein einen Erlaubnisschein bei sich führen und ihn auf Verlangen aushändigen oder elektronisch vorzeigen. Nicht erforderlich u. a. bei Helfern der Berechtigten (ohne Handangel), Eigentümern von Privatgewässern und genehmigten fischereilichen Veranstaltungen.",
      "basisId": "LFischG",
      "basisRef": "§ 37"
    }
  ],
  "otherRules": [
    {
      "topic": "Messen",
      "text": "Gemessen wird von der Kopfspitze bis zum Ende des längsten Teiles der Schwanzflosse.",
      "basisId": "LFischVO",
      "basisRef": "§ 3"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Die in den §§ 1 bis 3 genannten Arten sind, wenn sie während der Schonzeiten oder vor Erreichen der Mindestmaße lebend dem Wasser entnommen werden, unverzüglich mit der gebotenen Sorgfalt ins Fanggewässer zurückzusetzen. Muss mit ihrem Eingehen gerechnet werden, sind sie zu töten und unverzüglich zu vergraben, sofern am Fanggewässer eine anderweitige Beseitigung nicht vorgeschrieben ist. Ihre Verwertung ist auch dann verboten, wenn sie tot angelandet werden.",
      "basisId": "LFischVO",
      "basisRef": "§ 4 Abs. 1"
    },
    {
      "topic": "Meldepflicht Lachs und Meerforelle",
      "text": "Fänge von Lachs und Meerforelle sind innerhalb von sieben Tagen mit Angabe des Fundortes der unteren Fischereibehörde zu melden; die Pflicht zum Zurücksetzen bleibt unberührt.",
      "basisId": "LFischVO",
      "basisRef": "§ 4 Abs. 2"
    },
    {
      "topic": "Köderfische",
      "text": "Köderfische dürfen nur in dem Gewässer verwendet werden, aus dem sie stammen (oder einem damit verbundenen Gewässer). Lebende Köderfische dürfen nicht mitgeführt und nicht zum Fang verwendet werden. Die in den §§ 1 bis 3 genannten Arten dürfen als Köderfische weder feilgeboten noch abgegeben werden.",
      "basisId": "LFischVO",
      "basisRef": "§ 5 Abs. 1, § 6"
    },
    {
      "topic": "Aal-Fanglisten",
      "text": "Die Hegeverpflichteten (Fischereiberechtigte, -pächter und -genossenschaften) dokumentieren den Fang von Aalen anhand von Fanglisten der Freizeitfischer.",
      "basisId": "LFischVO",
      "basisRef": "§ 21 Abs. 1"
    }
  ]
}
