  "licences": [
    {
      "kind": "fishing_licence",
      "text": "Den Fischfang dürfen nur Personen ausüben, die Inhaber eines gültigen Fischereischeins sind.",
      "basisId": "HFischG",
      "basisRef": "§ 29 Abs. 1"
    },
    {
      "kind": "fishing_licence",
      "text": "Zusammengefasst: Der Fischereischein wird erteilt, wenn die antragstellende Person das 14. Lebensjahr vollendet und die Fischerprüfung bestanden hat und keine Versagungsgründe entgegenstehen; er gilt lebenslang. Er ist nur mit amtlichem Lichtbildausweis gültig und in Papierform oder digital mitzuführen.",
      "basisId": "HFischG",
      "basisRef": "§ 30 Abs. 1 und 2, § 34 Abs. 1 Nr. 1"
    },
    {
      "kind": "fishing_licence",
      "text": "Die oberste Fischereibehörde erkennt einen Fischereischein eines anderen Bundeslandes oder eines anderen EU-Mitgliedstaates an, wenn die Voraussetzungen, unter denen er erteilt wurde, denen nach diesem Gesetz entsprechen; die Anerkennung kann auch durch Allgemeinverfügung erfolgen.",
      "basisId": "HFischG",
      "basisRef": "§ 30 Abs. 3"
    },
    {
      "kind": "youth",
      "text": "Jugendliche, die das zehnte Lebensjahr vollendet und das sechzehnte noch nicht vollendet haben, dürfen den Fischfang mit der Handangel unter Aufsicht einer volljährigen Person mit gültigem Fischereischein ohne Fischereischein ausüben; das Alter ist auf Verlangen durch amtlichen Lichtbildausweis nachzuweisen. Kinder bis zehn Jahre dürfen einen Volljährigen beim Fischfang mit dessen Handangeln unterstützen.",
      "basisId": "HFischG",
      "basisRef": "§ 29 Abs. 3 und 4"
    },
    {
      "kind": "tourist",
      "text": "Personen, die im Inland keinen Wohnsitz haben und ihre Sachkunde (insbesondere durch einen ausländischen Fischereischein oder Fischereierlaubnisschein) nachweisen, kann ohne Fischerprüfung ein Besucherfischereischein für einen Monat in einem Kalenderjahr erteilt werden.",
      "basisId": "HFischG",
      "basisRef": "§ 33 Nr. 2, § 34 Abs. 1 Nr. 3"
    },
    {
      "kind": "levy",
      "text": "Wer die Fischerei ausüben will und einen hessischen Fischereischein besitzt, hat pro Kalenderjahr eine Fischereiabgabe zu entrichten (bis zu vier Jahre im Voraus möglich); der Nachweis ist mitzuführen. Das gilt auch für Jugendliche nach § 29 Abs. 4 mit gewöhnlichem Aufenthalt in Hessen.",
      "basisId": "HFischG",
      "basisRef": "§ 35 Abs. 1"
    },
    {
      "kind": "levy",
      "text": "Die Abgabe beträgt 10,00 Euro je Kalenderjahr für Inhaber eines Fischereischeins, Sonderfischereischeins oder Besucherfischereischeins und 3,50 Euro für Jugendliche nach § 29 Abs. 4 Satz 1 HFischG.",
      "basisId": "HFischV",
      "basisRef": "§ 27 Abs. 1"
    },
    {
      "kind": "permit",
      "text": "Fischereierlaubnisscheine dürfen nur Inhabern eines gültigen Fischereischeins oder Jugendlichen nach § 29 Abs. 4 erteilt werden und höchstens ein Kalenderjahr gelten. Sie sind in Papierform oder digital mitzuführen und auf Verlangen vorzuzeigen.",
      "basisId": "HFischG",
      "basisRef": "§ 16 Abs. 1"
    }
  ],
  "otherRules": [
    {
      "topic": "Messen",
      "text": "Das Entnahmemaß wird von der Spitze des Kopfes bis zum Ende der Schwanzflosse gemessen.",
      "basisId": "HFischV",
      "basisRef": "§ 2 Abs. 1"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Fische, Rundmäuler, Krebse und Muscheln, die entgegen den Fang- und Entnahmeverboten oder Schonzeiten und Entnahmemaßen lebend dem Wasser entnommen werden, sind unverzüglich und mit der gebotenen Sorgfalt in das Fanggewässer zurückzusetzen. Muss mit ihrem Verenden gerechnet werden, sind sie unverzüglich zu töten und zu vergraben, sofern eine anderweitige Beseitigung nicht vorgeschrieben ist.",
      "basisId": "HFischV",
      "basisRef": "§ 2 Abs. 3"
    },
    {
      "topic": "Abweichungen der Fischereiberechtigten",
      "text": "Eine Verkürzung der Schonzeiten oder Verringerung der Entnahmemaße durch die Inhaber des Fischereirechts oder Fischereiausübungsberechtigten ist unzulässig; Verlängerungen bzw. Vergrößerungen sind möglich und stehen dann auf dem Erlaubnisschein.",
      "basisId": "HFischV",
      "basisRef": "§ 2 Abs. 4"
    }
  ]
}
