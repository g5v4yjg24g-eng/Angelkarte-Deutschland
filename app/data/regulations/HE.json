  "otherRules": [
    {
      "topic": "Messen",
      "text": "Das Entnahmemaß wird von der Spitze des Kopfes bis zum Ende der Schwanzflosse gemessen.",
      "basisId": "HFischV",
      "basisRef": "§ 2 Abs. 1"
    },
    {
      "topic": "Zurücksetzen",
      "text": "Fische, Rundmäuler, Krebse und Muscheln, die entgegen den Fang- und Entnahmeverboten oder Schonzeiten und Entnahmemaßen lebend dem Wasser entnommen werden, sind unverzüglich und mit der gebotenen Sorgfalt in das Fanggewässer zurückzusetzen. Muss mit ihrem Verenden gerechnet werden, sind sie unverzüglich zu töten und zu vergraben, sofern eine anderweitige Beseitigung nicht vorgeschrieben ist.",
      "basisId": "HFischV",
      "basisRef": "§ 2 Abs. 3"
    },
    {
      "topic": "Abweichungen der Fischereiberechtigten",
      "text": "Eine Verkürzung der Schonzeiten oder Verringerung der Entnahmemaße durch die Inhaber des Fischereirechts oder Fischereiausübungsberechtigten ist unzulässig; Verlängerungen bzw. Vergrößerungen sind möglich und stehen dann auf dem Erlaubnisschein.",
      "basisId": "HFischV",
      "basisRef": "§ 2 Abs. 4"
    }
  ]
